---
import { furnitureSvg } from '~/lib/draw';
import type { FurnitureRender } from '~/lib/plan';

/**
 * One piece of furniture, drawn in the plan.
 *
 * The marks themselves live in lib/draw, because the planner draws the same pieces in
 * the browser and a sofa has to be the same sofa in both. This component is only the
 * Astro end of that: it exists so a page can write <FurnitureSymbol/> instead of calling
 * a function and piping the result through set:html.
 */

interface Props {
  item: FurnitureRender;
  /** Pixels-to-millimetres, from the frame the plan is drawn in. */
  px: (pixels: number) => number;
  /** Off in the whole-flat view, where the detail would only be noise. */
  detail: boolean;
  /** The drawing's drop-shadow filter, for pieces that stand on the floor. */
  cast?: string;
  /** The drawing's weave pattern, for mats. */
  weave?: string;
}

const { item, px, detail, cast, weave } = Astro.props;
---

<Fragment set:html={furnitureSvg(item, px, { detail, cast, weave })} />
