---
import { NAV_LINKS, SITE, withBase } from '~/consts';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = withBase(href).replace(/\/+$/, '') || '/';
  const root = withBase('/').replace(/\/+$/, '') || '/';
  if (target === root) return current === root;
  return current.startsWith(target);
}
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href={withBase('/')} class="group flex shrink-0 items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-md bg-brand text-white transition-transform duration-300 group-hover:-rotate-6"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path
            d="M2 15.5V6.2L9 2l7 4.2v9.3M2 15.5h14M7 15.5v-5h4v5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-serif text-[17px] font-bold tracking-tight text-ink">{SITE.name}</span>
        <span class="mt-0.5 text-2xs tracking-[0.16em] text-ink-faint uppercase">Drawn to scale</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm transition-colors duration-200',
              isActive(link.href)
                ? 'bg-brand-soft font-medium text-brand-deep'
                : 'text-ink-soft hover:bg-paper-deep hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <details class="relative ml-auto md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:bg-paper-deep"
        aria-label="Menu"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M2 4.5h14M2 9h14M2 13.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-3 w-52 overflow-hidden rounded-xl border border-line bg-card shadow-xl shadow-ink/5"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={withBase(link.href)}
              class:list={[
                'block border-b border-line-soft px-4 py-3 text-sm transition-colors last:border-0',
                isActive(link.href)
                  ? 'bg-brand-soft font-medium text-brand-deep'
                  : 'text-ink-soft hover:bg-paper-deep',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
