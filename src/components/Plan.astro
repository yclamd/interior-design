---
import FurnitureSymbol from '~/components/FurnitureSymbol.astro';
import { preferredDesign, type Mm, type Opening, type Project, type Room } from '~/data/types';
import { localeOf, say, type Locale } from '~/i18n';
import {
  bbox,
  envelopeOf,
  formatArea,
  formatLength,
  outlineInPlan,
  pathOf,
  roomArea,
  round,
} from '~/lib/geometry';
import {
  PLAN_COLOURS,
  dimension,
  floorRender,
  frameFor,
  furnitureRenders,
  glazedRenders,
  labelPoint,
  isDoorway,
  openingRender,
  projectBox,
  roomFill,
  roomPath,
  wallEdges,
} from '~/lib/plan';

/**
 * The plan. The same component draws the whole flat and a single room, because
 * both are the same geometry seen through a different frame — a room page is the
 * flat with the viewBox pulled in around one outline. Nothing is redrawn for the
 * close-up, so the two views cannot disagree.
 */

interface Props {
  project: Project;
  rooms: Room[];
  /** Room id to draw at full strength, with the rest held back as context. */
  focus?: string;
  /**
   * Which design to draw for the focused room. Every other room is drawn in its
   * preferred one, because a room being looked past is context and not a choice.
   */
  design?: string;
  /** Room names on every room, piece names on the focused room, or nothing. */
  labels?: 'rooms' | 'names' | 'none';
  furniture?: boolean;
  /** The floor a door leaf sweeps, which is worth seeing on a room page. */
  swept?: boolean;
  dimensions?: boolean;
  padding?: Mm;
  nominalWidth?: number;
  minWidth?: string;
  title: string;
  desc: string;
  /**
   * Only used for the room names written on the drawing. Taken from the URL when it is
   * not given, which is right on every page: a plan is always rendered inside a locale.
   */
  locale?: Locale;
}

const {
  project,
  rooms,
  focus,
  design: designId,
  labels = 'rooms',
  furniture = true,
  swept = false,
  dimensions = false,
  padding,
  nominalWidth = 960,
  minWidth = 'min-w-[42rem]',
  title,
  desc,
  locale = localeOf(Astro.url),
} = Astro.props;

const focused = focus ? rooms.find((room) => room.id === focus) : undefined;
const extent = focused ? bbox(outlineInPlan(focused)) : projectBox(project, rooms);
/**
 * Enough margin for the dimension strings and a wall's worth of neighbour, scaled
 * to the room: a fixed margin turns a bathroom into a small object in a large
 * field, and leaves a living room looking cropped.
 */
const margin = focused
  ? Math.min(1600, Math.max(800, Math.max(extent.width, extent.depth) * 0.32))
  : 500;
const frame = frameFor(extent, padding ?? margin, nominalWidth);
const px = frame.px;

/**
 * A shared door is listed by both rooms it serves, so that each room's own plan
 * is complete. Drawn from both sides it would double every arc, so each is drawn
 * once, from the room being looked at where there is one.
 */
const seen = new Map<string, { room: Room; opening: Opening }>();
for (const room of rooms) {
  for (const opening of room.openings) {
    const held = seen.get(opening.id);
    if (!held || room.id === focus) seen.set(opening.id, { room, opening });
  }
}
const drawnRooms = new Set(rooms.map((room) => room.id));

/** The design each room is drawn in: the asked-for one where it was asked for. */
const designOf = (room: Room) =>
  (room.id === focus && designId ? room.designs.find((d) => d.id === designId) : undefined) ??
  preferredDesign(room);

const openings = [...seen.values()].map(({ room, opening }) => ({
  ...openingRender(project, drawnRooms, room, opening),
  fill: isDoorway(opening.kind) ? roomFill(designOf(room)) : PLAN_COLOURS.sheet,
}));

/** Unique per drawing, since a compare page puts several on one document. */
const slug = [project.id, focus ?? 'all', designId].filter(Boolean).join('-');

const drawn = rooms.map((room) => {
  const design = designOf(room);
  const floor = floorRender(design);
  return {
    room,
    design,
    path: roomPath(room),
    /** Only the edges with something on the other side; open plan gets no line. */
    walls: wallEdges(room, rooms),
    /** Sides closed by a glazed screen, drawn as glazing rather than as a slab edge. */
    glazed: glazedRenders(room),
    fill: roomFill(design),
    floor,
    /** Each room's material is its own pattern, since the colours differ room to room. */
    floorId: `floor-${slug}-${room.id}`,
    strength: !focus || room.id === focus ? 1 : 0.75,
    area: roomArea(room),
    pieces: furniture ? furnitureRenders(room, design) : [],
  };
});

/** Set once the pieces are known, since the name goes where they are not. */
const labelled = drawn.map((entry) => ({
  ...entry,
  centre: labelPoint(
    outlineInPlan(entry.room),
    entry.pieces.filter((piece) => piece.kind !== 'rug' && !piece.mounted).map((piece) => piece.occupied),
  ),
}));

/**
 * Room names sit over whatever the room contains, so each is drawn twice: once as
 * a sheet-coloured outline and once filled on top. paint-order would say this in
 * one pass, but not every renderer honours it.
 */
const roomLabels =
  labels === 'rooms'
    ? labelled.map((entry) => {
        const name = say(entry.room.name, locale).toUpperCase();
        const box = bbox(outlineInPlan(entry.room));
        /**
         * Letter-spaced capitals, which is how a room is named on a drawing. The kind
         * used to be appended and was always a restatement of the name — a room called
         * Kitchen did not need telling it was one.
         *
         * The type shrinks to the room. A utility room is 1.5 m across and the words
         * UTILITY ROOM at the size the living room's name takes do not fit inside it;
         * set at that size the name ran out over the wall and into the flat next door.
         */
        const spacing = px(1.6);
        /**
         * A name is set along the room's longer side. Across the short side of a rain
         * shelter a metre wide, RAIN SHELTER does not fit at any size worth reading and
         * ran out over the slab's edge onto the paper.
         */
        const upright = box.depth > box.width * 1.35;
        const along = upright ? box.depth : box.width;
        const across = upright ? box.width : box.depth;
        const size = Math.min(px(11), Math.max(px(6.5), (along * 0.86) / (name.length * 0.72)));
        /** And what still will not fit is centred on the room rather than on the clear floor. */
        const half = (name.length * (size * 0.66 + spacing)) / 2;
        const middle = (from: Mm, extent: Mm, at: Mm, margin: Mm) =>
          margin * 2 > extent
            ? from + extent / 2
            : Math.min(Math.max(at, from + margin), from + extent - margin);
        const at = upright
          ? {
              x: middle(box.x, box.width, entry.centre.x, Math.min(size, across / 2)),
              y: middle(box.y, box.depth, entry.centre.y, half),
            }
          : {
              x: middle(box.x, box.width, entry.centre.x, half),
              y: middle(box.y, box.depth, entry.centre.y, Math.min(size, across / 2)),
            };
        return {
          lines: [
            {
              text: name,
              y: at.y,
              size,
              weight: 600,
              spacing,
              fill: PLAN_COLOURS.ink,
              opacity: entry.strength === 1 ? 0.88 : 0.5,
            },
            {
              text: formatArea(entry.area),
              y: at.y + size * 1.15,
              size: size * 0.78,
              weight: 400,
              spacing: px(0.4),
              fill: PLAN_COLOURS.inkSoft,
              opacity: entry.strength === 1 ? 0.8 : 0.45,
            },
          ],
          x: at.x,
          transform: upright ? `rotate(-90 ${round(at.x)} ${round(at.y)})` : undefined,
        };
      })
    : [];

/**
 * Names written on the pieces, rather than numbers to carry to a table. Each is set
 * along the piece's longer side and drawn twice, outline then fill, so it reads over
 * whatever it names. The type shrinks to fit the piece and then stops shrinking:
 * below about 5.5 px nothing is gained by making it smaller, so a long name on a
 * narrow piece is allowed to overrun rather than become unreadable.
 */
const pieceLabels =
  labels === 'names' && focused
    ? drawn
        .filter((entry) => entry.room.id === focused.id)
        .flatMap((entry) => entry.pieces)
        /** An empty label is how a piece says it is a continuation of the one before it. */
        .filter((piece) => piece.label.length > 0)
        /**
         * Six chairs round a table produced the word "Chair" six times, which told the
         * reader nothing they could not see and covered the table doing it. Where a
         * label would repeat, only the first one is written.
         */
        .filter((piece, i, all) => all.findIndex((other) => other.label === piece.label) === i)
        /**
         * A bedside table is 450 mm wide and "Bedside table, north" does not go on it at
         * any size worth reading. Pieces too small to carry their own name are left to
         * the schedule, which has room for the whole of it.
         */
        .filter((piece) => Math.max(piece.occupied.width, piece.occupied.depth) >= 700)
        .map((piece) => {
          const upright = piece.occupied.depth > piece.occupied.width * 1.35;
          const along = upright ? piece.occupied.depth : piece.occupied.width;
          const size = Math.min(
            px(9),
            Math.max(px(5.5), (along * 0.94) / Math.max(1, piece.label.length * 0.56)),
          );
          return { text: piece.label, size, at: piece.at, upright };
        })
    : [];

const dims = dimensions && focused
  ? (() => {
      const box = bbox(outlineInPlan(focused));
      return [
        dimension(
          { x: box.x, y: box.y + box.depth },
          { x: box.x + box.width, y: box.y + box.depth },
          px(46),
          formatLength(box.width),
        ),
        dimension(
          { x: box.x, y: box.y },
          { x: box.x, y: box.y + box.depth },
          -px(46),
          formatLength(box.depth),
        ),
      ];
    })()
  : [];

/** A round bar length that is a sensible fraction of what is on screen. */
const barLength = frame.box.width <= 6000 ? 1000 : frame.box.width <= 14000 ? 2000 : 5000;
const bar = {
  x: frame.box.x + px(16),
  y: frame.box.y + frame.box.depth - px(20),
  length: barLength,
  height: px(4),
  steps: 4,
};
const compass = {
  x: frame.box.x + frame.box.width - px(26),
  y: frame.box.y + px(26),
  r: px(15),
};
const titleId = `plan-title-${slug}`;
const descId = `plan-desc-${slug}`;
---

<div class={`table-scroll rounded-xl border border-line bg-[#f7f4ee] p-2`}>
  <svg
    viewBox={frame.viewBox}
    class={`h-auto w-full ${minWidth}`}
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
  >
    <title id={titleId}>{title}</title>
    <desc id={descId}>{desc}</desc>

    <defs>
      {
        drawn
          .filter((entry) => entry.floor.pattern !== 'none')
          .map((entry) => (
            <pattern
              id={entry.floorId}
              width={entry.floor.tile.width}
              height={entry.floor.tile.height}
              patternUnits="userSpaceOnUse"
            >
              <rect width={entry.floor.tile.width} height={entry.floor.tile.height} fill={entry.floor.colour} />
              <g fill="none" stroke={PLAN_COLOURS.floorLine} stroke-width={Math.max(4, px(0.45))}>
                {entry.floor.faint.map((d) => (
                  <path d={d} stroke-opacity={entry.floor.opacity * 0.45} />
                ))}
                {entry.floor.lines.map((d) => (
                  <path d={d} stroke-opacity={entry.floor.opacity} />
                ))}
              </g>
            </pattern>
          ))
      }
      {
        /**
         * A weave, drawn as lines on nothing and laid over a mat's own colour rather
         * than replacing it. One pattern serves every mat in the drawing because it
         * carries no fill of its own, and because it repeats in world space two
         * rectangles of one mat share a continuous weave with no seam where they meet.
         */
      }
      {
        /** Diagonals at 45°, which is how a drawing says "not in scope" without words. */
      }
      <pattern
        id={`unsurveyed-${slug}`}
        width="260"
        height="260"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect width="260" height="260" fill={PLAN_COLOURS.sheet} />
        <path
          d="M 0 0 V 260"
          fill="none"
          stroke={PLAN_COLOURS.structure}
          stroke-opacity="0.45"
          stroke-width={Math.max(8, px(0.9))}
        />
      </pattern>

      <pattern id={`weave-${slug}`} width="120" height="120" patternUnits="userSpaceOnUse">
        <g
          fill="none"
          stroke={PLAN_COLOURS.shadow}
          stroke-opacity="0.14"
          stroke-width={Math.max(3, px(0.35))}
        >
          <path d="M 0 0 H 120" />
          <path d="M 0 0 V 120" />
        </g>
      </pattern>

      <filter id={`cast-${slug}`} x="-30%" y="-30%" width="180%" height="180%">
        <feDropShadow
          dx={px(1.4)}
          dy={px(2.2)}
          stdDeviation={px(1.6)}
          flood-color={PLAN_COLOURS.shadow}
          flood-opacity="0.34"
        />
      </filter>
    </defs>

    <rect
      x={frame.box.x}
      y={frame.box.y}
      width={frame.box.width}
      height={frame.box.depth}
      fill={PLAN_COLOURS.sheet}
    />

    <path
      d={pathOf(envelopeOf(project, rooms))}
      fill={PLAN_COLOURS.structure}
      stroke={PLAN_COLOURS.structureEdge}
      stroke-width={px(1.4)}
    />

    {
      /** Over the poché and under the rooms, so a room drawn later still covers it. */
      (project.unsurveyed ?? []).map((area) => (
        <path
          d={pathOf(area)}
          fill={`url(#unsurveyed-${slug})`}
          stroke={PLAN_COLOURS.structureEdge}
          stroke-opacity="0.55"
          stroke-width={px(0.6)}
        />
      ))
    }

    {
      drawn.map((entry) => (
        <>
          <path
            d={entry.path}
            fill={entry.floor.pattern === 'none' ? entry.fill : `url(#${entry.floorId})`}
          />
          {entry.walls.length > 0 && (
            <path
              d={entry.walls}
              fill="none"
              stroke={PLAN_COLOURS.structureEdge}
              stroke-opacity="0.5"
              stroke-width={px(0.5)}
            />
          )}
          {entry.glazed.map((screen) => (
            <g>
              <path
                d={screen.band}
                fill={PLAN_COLOURS.sheet}
                stroke={PLAN_COLOURS.structureEdge}
                stroke-opacity="0.55"
                stroke-width={px(0.5)}
              />
              {screen.lines.map((d) => (
                <path
                  d={d}
                  fill="none"
                  stroke={PLAN_COLOURS.glazing}
                  stroke-opacity="0.95"
                  stroke-width={px(1)}
                />
              ))}
            </g>
          ))}
        </>
      ))
    }

    {
      /**
       * A room being looked past is faded towards the paper, not made transparent.
       * Held back by its own opacity it showed the near-black envelope through itself
       * and came out darker than the room in focus, which is the wrong way round.
       */
      drawn
        .filter((entry) => entry.strength !== 1)
        .map((entry) => <path d={entry.path} fill={PLAN_COLOURS.sheet} fill-opacity="0.5" />)
    }

    {
      openings.map((opening) => (
        <g>
          <path d={opening.gap} fill={opening.fill} />
          {opening.leaves.map((leaf) => (
            <path
              d={leaf}
              fill="none"
              stroke={opening.kind.startsWith('window') ? PLAN_COLOURS.glazing : PLAN_COLOURS.ink}
              stroke-opacity={opening.kind.startsWith('window') ? 0.95 : 0.6}
              stroke-width={px(opening.kind.startsWith('window') ? 1 : 0.8)}
            />
          ))}
          {opening.swing && (
            <>
              {swept && opening.sweptZone && (
                <path d={opening.sweptZone} fill={PLAN_COLOURS.ink} fill-opacity="0.05" />
              )}
              <path
                d={opening.swing.arc}
                fill="none"
                stroke={PLAN_COLOURS.ink}
                stroke-opacity="0.35"
                stroke-width={px(0.6)}
                stroke-dasharray={`${px(2.5)} ${px(2)}`}
              />
              <path
                d={opening.swing.leaf}
                fill="none"
                stroke={PLAN_COLOURS.ink}
                stroke-opacity="0.7"
                stroke-width={px(1.2)}
              />
            </>
          )}
        </g>
      ))
    }

    {
      drawn.map((entry) => (
        <g opacity={entry.strength === 1 ? 1 : 0.5}>
          {entry.pieces.map((piece) => (
            <FurnitureSymbol
              item={piece}
              px={px}
              detail={entry.strength === 1}
              cast={`cast-${slug}`}
              weave={`weave-${slug}`}
            />
          ))}
        </g>
      ))
    }

    {
      dims.map((dim) => {
        /**
         * A dimension for a room in the middle of the plan has to be read over
         * whatever is next door, so the figure gets its own patch of sheet rather
         * than relying on paint-order, which not every renderer honours.
         */
        const font = px(11);
        const plate = {
          width: dim.text.length * font * 0.62 + px(6),
          height: font * 1.15,
          y: dim.at.y - px(3.5),
        };
        return (
          <g stroke={PLAN_COLOURS.dimension} fill="none">
            <path d={dim.line} stroke-width={px(0.7)} />
            {dim.witnesses.map((witness) => (
              <path d={witness} stroke-width={px(0.5)} stroke-opacity="0.55" />
            ))}
            <g transform={dim.vertical ? `rotate(-90 ${dim.at.x} ${dim.at.y})` : undefined}>
              <rect
                x={dim.at.x - plate.width / 2}
                y={plate.y - font * 0.82}
                width={plate.width}
                height={plate.height}
                rx={px(2)}
                fill={PLAN_COLOURS.sheet}
                fill-opacity="0.93"
                stroke="none"
              />
              <text
                x={dim.at.x}
                y={plate.y}
                text-anchor="middle"
                font-size={font}
                font-weight="700"
                fill={PLAN_COLOURS.dimension}
                stroke="none"
              >
                {dim.text}
              </text>
            </g>
          </g>
        );
      })
    }

    {
      roomLabels.map((label) => (
        <g pointer-events="none" text-anchor="middle" transform={label.transform}>
          <g fill="none" stroke={PLAN_COLOURS.sheet} stroke-width={px(3)} stroke-linejoin="round">
            {label.lines.map((line) => (
              <text
                x={label.x}
                y={line.y}
                font-size={line.size}
                font-weight={line.weight}
                letter-spacing={line.spacing}
              >
                {line.text}
              </text>
            ))}
          </g>
          {label.lines.map((line) => (
            <text
              x={label.x}
              y={line.y}
              font-size={line.size}
              font-weight={line.weight}
              letter-spacing={line.spacing}
              fill={line.fill}
              fill-opacity={line.opacity}
            >
              {line.text}
            </text>
          ))}
        </g>
      ))
    }

    {
      pieceLabels.map((label) => (
        <g
          pointer-events="none"
          text-anchor="middle"
          transform={label.upright ? `rotate(-90 ${label.at.x} ${label.at.y})` : undefined}
        >
          <text
            x={label.at.x}
            y={label.at.y + label.size * 0.34}
            font-size={label.size}
            font-weight="700"
            fill="none"
            stroke={PLAN_COLOURS.sheet}
            stroke-width={label.size * 0.5}
            stroke-linejoin="round"
          >
            {label.text}
          </text>
          <text
            x={label.at.x}
            y={label.at.y + label.size * 0.34}
            font-size={label.size}
            font-weight="700"
            fill={PLAN_COLOURS.ink}
          >
            {label.text}
          </text>
        </g>
      ))
    }

    <g>
      <rect
        x={bar.x}
        y={bar.y}
        width={bar.length}
        height={bar.height}
        fill={PLAN_COLOURS.sheet}
        stroke={PLAN_COLOURS.ink}
        stroke-width={px(0.6)}
      />
      {
        Array.from({ length: bar.steps }, (_, i) =>
          i % 2 === 0 ? (
            <rect
              x={bar.x + (bar.length / bar.steps) * i}
              y={bar.y}
              width={bar.length / bar.steps}
              height={bar.height}
              fill={PLAN_COLOURS.ink}
              fill-opacity="0.8"
            />
          ) : null,
        )
      }
      <text
        x={bar.x}
        y={bar.y - px(4)}
        font-size={px(9.5)}
        font-weight="700"
        fill={PLAN_COLOURS.inkSoft}
      >
        0
      </text>
      <text
        x={bar.x + bar.length}
        y={bar.y - px(4)}
        text-anchor="middle"
        font-size={px(9.5)}
        font-weight="700"
        fill={PLAN_COLOURS.inkSoft}
      >
        {formatLength(bar.length)}
      </text>
    </g>

    <g transform={`rotate(${-project.northOffset} ${compass.x} ${compass.y})`}>
      <circle
        cx={compass.x}
        cy={compass.y}
        r={compass.r}
        fill={PLAN_COLOURS.sheet}
        fill-opacity="0.8"
        stroke={PLAN_COLOURS.inkSoft}
        stroke-opacity="0.5"
        stroke-width={px(0.6)}
      />
      <path
        d={`M ${compass.x} ${compass.y - compass.r * 0.72} L ${compass.x + compass.r * 0.3} ${
          compass.y + compass.r * 0.34
        } L ${compass.x} ${compass.y + compass.r * 0.1} L ${compass.x - compass.r * 0.3} ${
          compass.y + compass.r * 0.34
        } Z`}
        fill={PLAN_COLOURS.ink}
        fill-opacity="0.75"
      />
      <text
        x={compass.x}
        y={compass.y - compass.r * 0.95}
        text-anchor="middle"
        font-size={px(8.5)}
        font-weight="700"
        fill={PLAN_COLOURS.inkSoft}
      >
        N
      </text>
    </g>
  </svg>
</div>
