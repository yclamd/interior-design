---
import { NAV_LINKS, SITE, withBase } from '~/consts';
import { PROJECTS } from '~/data/projects';

const rooms = PROJECTS.reduce((sum, entry) => sum + entry.rooms.length, 0);
---

<footer class="mt-20 border-t border-line bg-paper-deep/40">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <p class="font-serif text-lg font-bold text-ink">{SITE.name}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{SITE.description}</p>
        <p class="mt-4 text-2xs tracking-[0.14em] text-ink-faint uppercase">
          All dimensions in millimetres · {PROJECTS.length} projects · {rooms} rooms
        </p>
      </div>
      <nav class="flex flex-col gap-2" aria-label="Footer">
        {
          NAV_LINKS.map((link) => (
            <a
              href={withBase(link.href)}
              class="text-sm text-ink-soft transition-colors hover:text-brand"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
