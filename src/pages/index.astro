---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Plan from '~/components/Plan.astro';
import { PROJECTS, SCOPE_LABELS } from '~/data/projects';
import { STYLES } from '~/data/styles';
import { SITE, withBase } from '~/consts';
import { checkDesign, checkProject } from '~/lib/checks';
import { preferredDesign } from '~/data/types';
import { bbox, envelopeOf, formatArea, formatLength, roomArea } from '~/lib/geometry';

const cards = PROJECTS.map((entry) => {
  const drawn = entry.rooms.reduce((sum, room) => sum + roomArea(room), 0);
  const envelope = bbox(envelopeOf(entry.project, entry.rooms));
  const findings = [
    ...checkProject(entry.project, entry.rooms),
    ...entry.rooms.flatMap((room) => room.designs.flatMap((design) => checkDesign(room, design))),
  ];
  return {
    ...entry,
    drawn,
    envelope,
    conflicts: findings.filter((finding) => finding.severity === 'error').length,
    designs: entry.rooms.reduce((sum, room) => sum + room.designs.length, 0),
  };
});

const totalRooms = PROJECTS.reduce((sum, entry) => sum + entry.rooms.length, 0);
const totalDesigns = cards.reduce((sum, card) => sum + card.designs, 0);

/**
 * The rooms carrying more than one design, with a few of each drawn.
 *
 * A project card shows one plan and cannot say that a room has ten answers, which is most
 * of what this site is for — the point of the dataset is that the same measured shell can
 * be furnished several ways and the drawings compared. So the front page shows the
 * arrangements themselves rather than only the flats they are in.
 *
 * Four per room, not all of them. Each of these plans carries the whole project's geometry,
 * so twenty of them is a page that takes a moment to paint for no more information than
 * four and a link give.
 */
const SHOWN = 4;

const choices = PROJECTS.flatMap((entry) =>
  entry.rooms
    .filter((room) => room.designs.length > 1)
    .map((room) => ({
      entry,
      room,
      shown: room.designs.slice(0, SHOWN),
      total: room.designs.length,
    })),
);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-10 sm:px-8 sm:pt-20">
    <p class="eyebrow">
      {PROJECTS.length} projects · {totalRooms} rooms · {totalDesigns} designs
    </p>
    <h1 class="mt-3 max-w-3xl font-serif text-3xl leading-tight font-bold text-ink sm:text-[2.6rem]">
      Interiors, drawn from their dimensions
    </h1>
    <p class="lede mt-5 max-w-2xl">{SITE.description}</p>
    <p class="prose-note mt-4 max-w-2xl">
      A project here is one job: a whole dwelling, a floor of one, or a single room. They are all the
      same thing in the data — a list of rooms with real sizes in millimetres — so a one-room job gets
      the same drawings and the same checks as a flat.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8">
    <ul class="grid gap-6 lg:grid-cols-2">
      {
        cards.map((card) => (
          <li class="card overflow-hidden">
            <a href={withBase(`/projects/${card.project.id}`)} class="group block">
              <div class="border-b border-line bg-[#f7f4ee] p-2">
                <Plan
                  project={card.project}
                  rooms={card.rooms}
                  labels="none"
                  nominalWidth={620}
                  minWidth="min-w-0"
                  title={`Floor plan of ${card.project.name}`}
                  desc={`${card.project.name}: ${card.rooms.length} rooms totalling ${formatArea(card.drawn)}.`}
                />
              </div>
              <div class="p-5 sm:p-6">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-2xs tracking-[0.14em] text-ink-faint uppercase">
                    {SCOPE_LABELS[card.project.scope]}
                  </span>
                  {card.conflicts > 0 && (
                    <span class="rounded-full bg-flag-soft px-2 py-0.5 text-2xs font-bold text-flag">
                      {card.conflicts} conflicts
                    </span>
                  )}
                  {card.designs > card.rooms.length && (
                    <span class="rounded-full bg-brand-soft px-2 py-0.5 text-2xs font-bold text-brand-deep">
                      {card.designs} designs to compare
                    </span>
                  )}
                </div>
                <h2 class="mt-2 font-serif text-2xl font-bold text-ink transition-colors group-hover:text-brand">
                  {card.project.name}
                </h2>
                <p class="mt-1 text-sm text-ink-faint">{card.project.location}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{card.project.premise}</p>
                <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line-soft pt-4">
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Rooms</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">{card.rooms.length}</dd>
                  </div>
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Floor</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">{formatArea(card.drawn)}</dd>
                  </div>
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Envelope</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">
                      {formatLength(card.envelope.width)} × {formatLength(card.envelope.depth)}
                    </dd>
                  </div>
                </dl>
                <p class="mt-3 text-2xs tracking-[0.14em] text-ink-faint uppercase">
                  {[...new Set(card.rooms.map((room) => STYLES[preferredDesign(room).style].name))].join(' · ')}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    choices.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl px-5 sm:px-8">
        <p class="eyebrow">One shell, several answers</p>
        <h2 class="mt-3 max-w-3xl font-serif text-2xl leading-tight font-bold text-ink sm:text-3xl">
          Rooms with a choice still open
        </h2>
        <p class="prose-note mt-4 max-w-2xl">
          A room is a measured fact and a design is not, so a room can carry as many as it needs
          and every one of them is drawn against the same walls and run through the same checks.
          These are the rooms where the decision has not been made.
        </p>

        <ul class="mt-8 space-y-10">
          {choices.map((choice) => (
            <li>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-serif text-xl font-bold text-ink">{choice.room.name}</h3>
                <span class="text-sm text-ink-faint">{choice.entry.project.name}</span>
                <a
                  href={withBase(
                    `/projects/${choice.entry.project.id}/rooms/${choice.room.id}/compare`,
                  )}
                  class="text-2xs font-bold tracking-[0.14em] text-brand uppercase transition-colors hover:text-brand-deep"
                >
                  compare all {choice.total}
                </a>
              </div>
              <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {choice.shown.map((design) => (
                  <li class="card overflow-hidden">
                    <a
                      href={withBase(
                        `/projects/${choice.entry.project.id}/rooms/${choice.room.id}${
                          design.preferred ? '' : `/${design.id}`
                        }`,
                      )}
                      class="group block"
                    >
                      <div class="border-b border-line bg-[#f7f4ee] p-1.5">
                        <Plan
                          project={choice.entry.project}
                          rooms={[choice.room]}
                          focus={choice.room.id}
                          design={design.id}
                          labels="none"
                          dimensions={false}
                          nominalWidth={300}
                          minWidth="min-w-0"
                          title={`${choice.room.name}: ${design.name}`}
                          desc={design.theme}
                        />
                      </div>
                      <div class="p-3">
                        <p class="text-xs leading-snug font-medium text-ink transition-colors group-hover:text-brand">
                          {design.name}
                        </p>
                        <p class="mt-1 text-2xs tracking-[0.12em] text-ink-faint uppercase">
                          {STYLES[design.style].name}
                        </p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:px-8">
    <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="font-serif text-xl font-bold text-ink">Adding one of your own</h2>
        <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-ink-soft">
          Every drawing is generated from a list of measurements, so the work is the surveying. The
          method page is the sheet to fill in, field by field, with what to measure and from where.
        </p>
      </div>
      <a
        href={withBase('/method')}
        class="shrink-0 rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
      >
        The survey sheet
      </a>
    </div>
  </section>
</BaseLayout>
