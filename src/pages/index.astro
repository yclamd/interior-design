---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Plan from '~/components/Plan.astro';
import Findings from '~/components/Findings.astro';
import { HABITABLE, HOME, KIND_LABELS, ROOMS } from '~/data/home';
import { STYLES } from '~/data/styles';
import { SITE, withBase } from '~/consts';
import { checkHome } from '~/lib/checks';
import {
  SQM_PER_PING,
  bbox,
  formatArea,
  formatLength,
  outlineOf,
  polygonArea,
  roomArea,
} from '~/lib/geometry';

const findings = checkHome(HOME, ROOMS);

const drawnArea = ROOMS.reduce((sum, room) => sum + roomArea(room), 0);
const habitableArea = ROOMS.filter((room) => HABITABLE.includes(room.kind)).reduce(
  (sum, room) => sum + roomArea(room),
  0,
);
const grossArea = polygonArea(HOME.envelope);
const envelope = bbox(HOME.envelope);
const bedrooms = ROOMS.filter((room) => room.kind === 'bedroom').length;

const rows = ROOMS.map((room) => {
  const box = bbox(outlineOf(room));
  return {
    room,
    area: roomArea(room),
    dimensions:
      room.shape.kind === 'rect'
        ? `${room.shape.width} × ${room.shape.depth}`
        : `${box.width} × ${box.depth} overall`,
  };
});

const stats = [
  { label: 'Rooms drawn', value: String(ROOMS.length), note: `${bedrooms} bedrooms` },
  {
    label: 'Floor drawn',
    value: formatArea(drawnArea),
    note: `${(drawnArea / 1_000_000 / SQM_PER_PING).toFixed(1)} ping`,
  },
  {
    label: 'Habitable of it',
    value: formatArea(habitableArea),
    note: `${Math.round((habitableArea / drawnArea) * 100)}% of the floor`,
  },
  {
    label: 'Envelope',
    value: `${formatLength(envelope.width)} × ${formatLength(envelope.depth)}`,
    note: `${formatArea(grossArea)} gross`,
  },
  { label: 'Ceiling', value: formatLength(HOME.ceiling), note: 'unless a room says otherwise' },
  {
    label: 'Registered',
    value: HOME.registeredArea ? `${HOME.registeredArea.toFixed(1)} m²` : '—',
    note: HOME.registeredArea ? 'from the deed' : 'not recorded',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: SITE.name,
  description: SITE.description,
  about: { '@type': 'Residence', name: HOME.name, floorSize: {
    '@type': 'QuantitativeValue',
    unitCode: 'MTK',
    value: Number((drawnArea / 1_000_000).toFixed(2)),
  } },
};
---

<BaseLayout title={SITE.name} description={SITE.description} schema={schema}>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-10 sm:px-8 sm:pt-20">
    <p class="eyebrow">{HOME.location}</p>
    <h1 class="mt-3 max-w-3xl font-serif text-3xl leading-tight font-bold text-ink sm:text-[2.6rem]">
      {HOME.name}, set out at full size
    </h1>
    <p class="lede mt-5 max-w-2xl">{HOME.premise}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8">
    <Plan
      home={HOME}
      rooms={ROOMS}
      labels="rooms"
      title={`Floor plan of ${HOME.name}`}
      desc={`A scaled floor plan of the whole home: ${ROOMS.length} rooms totalling ${formatArea(drawnArea)}, drawn inside a ${formatLength(envelope.width)} by ${formatLength(envelope.depth)} envelope with ${HOME.walls.exterior} mm exterior and ${HOME.walls.interior} mm interior walls.`}
      nominalWidth={1100}
    />
    <p class="mt-3 text-xs leading-relaxed text-ink-faint">
      Walls are not drawn as lines. The envelope is filled and each room is filled on top of it, so
      every partition comes out at exactly the thickness the room positions imply — {HOME.walls.interior} mm
      inside, {HOME.walls.exterior} mm at the perimeter.
    </p>
  </section>

  <section class="mx-auto mt-12 max-w-6xl px-5 sm:px-8">
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        stats.map((stat) => (
          <div class="card p-4">
            <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{stat.label}</dt>
            <dd class="mt-1.5 font-serif text-lg font-bold text-ink tabular">{stat.value}</dd>
            <dd class="mt-0.5 text-xs text-ink-faint">{stat.note}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
    <h2 class="font-serif text-2xl font-bold text-ink">Every room, with its figures</h2>
    <p class="prose-note mt-2 max-w-2xl">
      Sizes are the clear internal dimensions between finished wall faces, which is what furniture
      has to fit inside — not the structural grid.
    </p>

    <div class="card table-scroll mt-6">
      <table class="spec min-w-[44rem]">
        <thead>
          <tr>
            <th scope="col">Room</th>
            <th scope="col">Use</th>
            <th scope="col">Size (mm)</th>
            <th scope="col">Floor</th>
            <th scope="col">Ceiling</th>
            <th scope="col">Style</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">
                  <a
                    href={withBase(`/rooms/${row.room.id}`)}
                    class="font-medium text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:text-clay"
                  >
                    {row.room.name}
                  </a>
                </th>
                <td class="text-ink-soft">{KIND_LABELS[row.room.kind]}</td>
                <td class="whitespace-nowrap">{row.dimensions}</td>
                <td class="whitespace-nowrap">{formatArea(row.area)}</td>
                <td class="whitespace-nowrap">{row.room.ceiling}</td>
                <td class="text-ink-soft">{STYLES[row.room.style].name}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
    <Findings
      findings={findings}
      heading="What the whole-plan checks found"
      clear="No rooms overlap, every door leads somewhere real, and the drawn area is close enough to the deed to be explained by walls and shafts."
    />
  </section>

  <section class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
    <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="font-serif text-xl font-bold text-ink">Room by room</h2>
        <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-ink-soft">
          Each room has its own drawing at a closer scale, a furniture schedule in millimetres, and
          the list of what its dimensions rule out.
        </p>
      </div>
      <a
        href={withBase('/rooms')}
        class="shrink-0 rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
      >
        See the rooms
      </a>
    </div>
  </section>
</BaseLayout>
