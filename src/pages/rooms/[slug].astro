---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Plan from '~/components/Plan.astro';
import Findings from '~/components/Findings.astro';
import Schedule from '~/components/Schedule.astro';
import { HOME, KIND_LABELS, ROOMS, roomById } from '~/data/home';
import { STYLES } from '~/data/styles';
import { withBase } from '~/consts';
import { checkRoom } from '~/lib/checks';
import { describe } from '~/lib/plan';
import {
  SQM_PER_PING,
  bbox,
  footprintArea,
  formatArea,
  formatLength,
  outlineOf,
  roomArea,
} from '~/lib/geometry';

export const getStaticPaths: GetStaticPaths = () =>
  ROOMS.map((room) => ({ params: { slug: room.id }, props: { id: room.id } }));

const { id } = Astro.props as { id: string };
const room = roomById(id)!;

const findings = checkRoom(room);
const area = roomArea(room);
const box = bbox(outlineOf(room));
const style = STYLES[room.style];
const covered = area > 0 ? footprintArea(room) / area : 0;
const volume = (area / 1_000_000) * (room.ceiling / 1000);

const index = ROOMS.findIndex((entry) => entry.id === room.id);
const previous = ROOMS[index - 1];
const next = ROOMS[index + 1];

const doors = room.openings.filter((opening) => opening.kind.startsWith('door'));
const windows = room.openings.filter((opening) => opening.kind.startsWith('window'));

const specs = [
  { label: 'Clear size', value: `${box.width} × ${box.depth} mm` },
  { label: 'Floor area', value: `${formatArea(area)} · ${(area / 1_000_000 / SQM_PER_PING).toFixed(2)} ping` },
  { label: 'Ceiling', value: formatLength(room.ceiling) },
  { label: 'Volume', value: `${volume.toFixed(1)} m³` },
  { label: 'Floor covered', value: `${Math.round(covered * 100)}% by furniture` },
  { label: 'Floor finish', value: room.floor.name },
  { label: 'Style', value: style.name },
  { label: 'Openings', value: `${doors.length} doors, ${windows.length} windows` },
];

const legend = [
  { swatch: '#b9b0a0', label: 'Wall', note: `${HOME.walls.interior} mm inside, ${HOME.walls.exterior} mm at the perimeter` },
  { swatch: room.floor.colour ?? style.palette.floor, label: 'This room', note: room.floor.name },
  { swatch: style.palette.furniture, label: 'Furniture', note: 'Drawn at its catalogue footprint' },
  { swatch: '#c98a3f', label: 'Clearance', note: 'Space a piece needs in front of it to be usable' },
  { swatch: '#7fa8c9', label: 'Glazing', note: 'Sill heights are in the openings table' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Room',
  name: room.name,
  description: room.summary,
  floorSize: {
    '@type': 'QuantitativeValue',
    unitCode: 'MTK',
    value: Number((area / 1_000_000).toFixed(2)),
  },
};
---

<BaseLayout
  title={room.name}
  description={`${room.name}: ${box.width} × ${box.depth} mm, ${formatArea(area)}, drawn to scale with its furniture at real sizes. ${room.theme}`}
  schema={schema}
>
  <section class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-14">
    <nav aria-label="Breadcrumb" class="text-2xs tracking-[0.14em] text-ink-faint uppercase">
      <a href={withBase('/')} class="transition-colors hover:text-brand">The plan</a>
      <span class="mx-2">/</span>
      <a href={withBase('/rooms')} class="transition-colors hover:text-brand">Rooms</a>
      <span class="mx-2">/</span>
      <span class="text-ink-soft">{room.name}</span>
    </nav>

    <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <h1 class="font-serif text-3xl leading-tight font-bold text-ink sm:text-[2.4rem]">
        {room.name}
      </h1>
      <span class="rounded-full bg-paper-deep px-3 py-1 text-2xs font-bold tracking-[0.14em] text-ink-soft uppercase">
        {KIND_LABELS[room.kind]}
      </span>
    </div>
    <p class="lede mt-4 max-w-2xl">{room.theme}</p>
  </section>

  <section class="mx-auto mt-8 max-w-6xl px-5 sm:px-8">
    <Plan
      home={HOME}
      rooms={ROOMS}
      focus={room.id}
      labels="keys"
      dimensions
      clearance
      swept
      nominalWidth={1000}
      title={`Plan of the ${room.name.toLowerCase()}`}
      desc={`${room.name}, ${box.width} by ${box.depth} millimetres, ${formatArea(area)}, with ${room.furniture.length} pieces of furniture drawn at their measured footprints and numbered to match the schedule.`}
    />

    <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      {
        legend.map((entry) => (
          <li class="flex items-start gap-2 text-xs">
            <span
              class="mt-0.5 h-3.5 w-3.5 shrink-0 rounded-sm border border-line"
              style={`background:${entry.swatch}`}
              aria-hidden="true"
            />
            <span>
              <span class="font-bold text-ink">{entry.label}</span>
              <span class="ml-1.5 text-ink-faint">{entry.note}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-12 max-w-6xl px-5 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[1.35fr_1fr]">
      <div>
        <h2 class="font-serif text-2xl font-bold text-ink">How it is meant to work</h2>
        <p class="prose-note mt-3">{room.summary}</p>

        <h3 class="mt-8 font-serif text-lg font-bold text-ink">The style it is drawn in</h3>
        <p class="prose-note mt-2">{style.premise}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {
            style.materials.map((material) => (
              <li class="rounded-full border border-line bg-card px-2.5 py-1 text-xs text-ink-soft">
                {material}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card table-scroll self-start">
        <table class="spec">
          <caption class="border-b border-line px-4 py-3 text-left">
            <span class="font-serif text-base font-bold text-ink">Dimensions</span>
          </caption>
          <tbody>
            {
              specs.map((spec) => (
                <tr>
                  <th scope="row" class="w-40">{spec.label}</th>
                  <td class="text-ink">{spec.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-12 max-w-6xl px-5 sm:px-8">
    <Schedule room={room} />
  </section>

  <section class="mx-auto mt-8 max-w-6xl px-5 sm:px-8">
    <div class="card table-scroll">
      <table class="spec min-w-[40rem]">
        <caption class="border-b border-line px-4 py-3 text-left">
          <span class="font-serif text-base font-bold text-ink">Doors and windows</span>
          <span class="ml-2 text-2xs tracking-[0.14em] text-ink-faint uppercase">
            offsets measured along the wall, millimetres
          </span>
        </caption>
        <thead>
          <tr>
            <th scope="col">Opening</th>
            <th scope="col">Offset</th>
            <th scope="col">Width</th>
            <th scope="col">Height</th>
            <th scope="col">Sill</th>
            <th scope="col">Leads to</th>
          </tr>
        </thead>
        <tbody>
          {
            room.openings.map((opening) => (
              <tr>
                <th scope="row">
                  <span class="font-medium text-ink">{describe(opening)}</span>
                  {opening.swing && (
                    <span class="block text-2xs text-ink-faint">
                      Hinged {opening.swing.startsWith('left') ? 'left' : 'right'}, opens{' '}
                      {opening.swing.endsWith('-in') ? 'into this room' : 'away from this room'}
                    </span>
                  )}
                  {opening.note && (
                    <span class="mt-1 block text-xs leading-relaxed text-ink-soft">{opening.note}</span>
                  )}
                </th>
                <td>{opening.offset}</td>
                <td>{opening.width}</td>
                <td>{opening.height}</td>
                <td>{opening.sill === 0 ? '—' : opening.sill}</td>
                <td class="text-ink-soft">
                  {opening.to && opening.to !== 'outside' && roomById(opening.to) ? (
                    <a
                      href={withBase(`/rooms/${opening.to}`)}
                      class="text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:text-clay"
                    >
                      {roomById(opening.to)!.name}
                    </a>
                  ) : (
                    (opening.to ?? '—')
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto mt-8 max-w-6xl px-5 sm:px-8">
    <div class="grid gap-6 lg:grid-cols-2">
      <Findings
        findings={findings}
        heading="What the checks found here"
        clear="Nothing in this room fouls anything else: every door opens fully, every piece has the space in front of it that it needs, and nothing sits outside the walls."
      />

      {
        room.openQuestions && room.openQuestions.length > 0 && (
          <section class="card p-5 sm:p-6">
            <h2 class="font-serif text-lg font-bold text-ink">Still undecided</h2>
            <p class="mt-1.5 text-2xs tracking-[0.14em] text-ink-faint uppercase">
              printed so it is not quietly forgotten
            </p>
            <ul class="mt-4 space-y-3">
              {room.openQuestions.map((question) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true" />
                  <span>{question}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </section>

  <nav
    class="mx-auto mt-14 flex max-w-6xl flex-col gap-3 px-5 sm:flex-row sm:px-8"
    aria-label="Other rooms"
  >
    {
      previous && (
        <a
          href={withBase(`/rooms/${previous.id}`)}
          class="card flex-1 p-5 transition-colors hover:border-brand/40"
        >
          <span class="text-2xs tracking-[0.14em] text-ink-faint uppercase">Previous</span>
          <span class="mt-1 block font-serif text-lg font-bold text-ink">{previous.name}</span>
        </a>
      )
    }
    {
      next && (
        <a
          href={withBase(`/rooms/${next.id}`)}
          class="card flex-1 p-5 text-right transition-colors hover:border-brand/40"
        >
          <span class="text-2xs tracking-[0.14em] text-ink-faint uppercase">Next</span>
          <span class="mt-1 block font-serif text-lg font-bold text-ink">{next.name}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>
