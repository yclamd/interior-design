---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Plan from '~/components/Plan.astro';
import { PROJECTS, SCOPE_LABELS } from '~/data/projects';
import { SITE } from '~/consts';
import { preferredDesign } from '~/data/types';
import { formatArea, roomArea } from '~/lib/geometry';
import { say, LOCALES, localeHref, strings, type Locale } from '~/i18n';

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES.map((locale) => ({ params: { locale } }));

const locale = Astro.params.locale as Locale;
const s = strings(locale);

/**
 * The front page is the drawings.
 *
 * It used to open with four paragraphs explaining what a project is and how the dataset
 * works, which is the thing a reader can find out by looking at one plan. So the prose
 * is gone from here and lives on the method page, and what is left is one full-bleed
 * plan of the flat being surveyed, the other projects as plates, and the arrangements
 * that are still undecided. Every caption is a number or a name; nothing on this page
 * argues with anything.
 */

const projects = PROJECTS.map((entry) => ({
  ...entry,
  drawn: entry.rooms.reduce((sum, room) => sum + roomArea(room), 0),
  designs: entry.rooms.reduce((sum, room) => sum + room.designs.length, 0),
}));

/** The real job leads; the rest are plates below it. */
const lead = projects[0]!;
const rest = projects.slice(1);

/**
 * Four per room rather than all of them, drawn as the room alone. Each plan carries the
 * geometry it is given, so twenty whole-flat plans is a page that takes a moment to paint
 * for no more information than four rooms and a link.
 */
const SHOWN = 4;
const choices = PROJECTS.flatMap((entry) =>
  entry.rooms
    .filter((room) => room.designs.length > 1)
    .map((room) => ({ entry, room, shown: room.designs.slice(0, SHOWN), total: room.designs.length })),
);
---

<BaseLayout locale={locale} title={SITE.name} description={SITE.description}>
  {/* The lead plate: one drawing, one line, and a way in. */}
  <section class="border-b border-line bg-[#f7f4ee]">
    <div class="mx-auto max-w-6xl px-5 pt-10 pb-4 sm:px-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h1 class="font-serif text-2xl leading-none font-bold text-ink sm:text-3xl">
          {say(lead.project.name, locale)}
        </h1>
        <p class="font-mono text-xs tracking-[0.1em] text-ink-faint uppercase tabular">
          {lead.rooms.length} {s.common.rooms.toLowerCase()} · {formatArea(lead.drawn)} · {lead.designs}
          {' '}{s.common.designs.toLowerCase()}
        </p>
      </div>
    </div>
    <a href={localeHref(locale, `/projects/${lead.project.id}`)} class="group block">
      <div class="mx-auto max-w-6xl px-2 pb-6 sm:px-5">
        <Plan
          project={lead.project}
          rooms={lead.rooms}
          labels="rooms"
          nominalWidth={1240}
          minWidth="min-w-0"
          title={`Floor plan of ${say(lead.project.name, locale)}`}
          desc={`${lead.rooms.length} rooms totalling ${formatArea(lead.drawn)}.`}
        />
      </div>
      <div class="mx-auto max-w-6xl px-5 pb-8 sm:px-8">
        <span
          class="inline-flex items-center gap-2 text-sm font-medium text-brand transition-colors group-hover:text-brand-deep"
        >
          {s.home.enter}
          <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>
  </section>

  {/* The other projects, as plates. */}
  <section class="mx-auto max-w-6xl px-5 pt-12 sm:px-8">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="eyebrow">{s.home.allProjects}</h2>
    </div>
    <ul class="mt-5 grid gap-5 sm:grid-cols-3">
      {
        rest.map((card) => (
          <li class="card overflow-hidden">
            <a href={localeHref(locale, `/projects/${card.project.id}`)} class="group block">
              <div class="border-b border-line bg-[#f7f4ee] p-2">
                <Plan
                  project={card.project}
                  rooms={card.rooms}
                  labels="none"
                  nominalWidth={420}
                  minWidth="min-w-0"
                  title={`Floor plan of ${say(card.project.name, locale)}`}
                  desc={`${card.rooms.length} rooms totalling ${formatArea(card.drawn)}.`}
                />
              </div>
              <div class="p-4">
                <h3 class="font-serif text-base font-bold text-ink transition-colors group-hover:text-brand">
                  {say(card.project.name, locale)}
                </h3>
                <p class="mt-1 font-mono text-2xs tracking-[0.1em] text-ink-faint uppercase tabular">
                  {say(SCOPE_LABELS[card.project.scope], locale)} · {formatArea(card.drawn)}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* The undecided arrangements, which is what the site is actually for. */}
  {
    choices.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pt-14 sm:px-8">
        <h2 class="eyebrow">{s.home.designsToCompare}</h2>
        <ul class="mt-5 space-y-8">
          {choices.map((choice) => (
            <li>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-serif text-lg font-bold text-ink">{say(choice.room.name, locale)}</h3>
                <span class="font-mono text-2xs tracking-[0.1em] text-ink-faint uppercase tabular">
                  {say(choice.entry.project.name, locale)}
                </span>
                <a
                  href={localeHref(
                    locale,
                    `/projects/${choice.entry.project.id}/rooms/${choice.room.id}/compare`,
                  )}
                  class="text-2xs font-bold tracking-[0.14em] text-brand uppercase transition-colors hover:text-brand-deep"
                >
                  {s.home.compareAll} {choice.total}
                </a>
              </div>
              <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {choice.shown.map((design) => (
                  <li class="card overflow-hidden">
                    <a
                      href={localeHref(
                        locale,
                        `/projects/${choice.entry.project.id}/rooms/${choice.room.id}${
                          design.preferred ? '' : `/${design.id}`
                        }`,
                      )}
                      class="group block"
                    >
                      <div class="border-b border-line bg-[#f7f4ee] p-1.5">
                        <Plan
                          project={choice.entry.project}
                          rooms={[choice.room]}
                          focus={choice.room.id}
                          design={design.id}
                          labels="none"
                          dimensions={false}
                          nominalWidth={300}
                          minWidth="min-w-0"
                          title={`${say(choice.room.name, locale)}: ${say(design.name, locale)}`}
                          desc={say(design.theme, locale)}
                        />
                      </div>
                      <div class="p-2.5">
                        <p class="text-xs leading-snug font-medium text-ink transition-colors group-hover:text-brand">
                          {say(design.name, locale)}
                        </p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* One way out, to the thing a visitor might want to do rather than read. */}
  <section class="mx-auto mt-16 max-w-6xl px-5 sm:px-8">
    <a
      href={localeHref(locale, '/planner')}
      class="card group flex flex-col gap-3 p-6 transition-colors hover:border-brand/40 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    >
      <div>
        <h2 class="font-serif text-xl font-bold text-ink transition-colors group-hover:text-brand">
          {s.home.tryPlanner}
        </h2>
        <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-ink-soft">{s.home.plannerNote}</p>
      </div>
      <span
        class="shrink-0 rounded-full bg-brand px-5 py-2.5 text-center text-sm font-medium text-white transition-colors group-hover:bg-brand-deep"
      >
        {s.planner.title}
      </span>
    </a>
  </section>
</BaseLayout>
