---
import type { GetStaticPaths } from 'astro';
import { LOCALES, localeHref, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Plan from '~/components/Plan.astro';
import { KIND_LABELS, PROJECTS, projectById } from '~/data/projects';
import { STYLES } from '~/data/styles';
import { preferredDesign } from '~/data/types';
import { checkDesign, worst } from '~/lib/checks';
import { bbox, footprintArea, formatArea, outlineOf, roomArea } from '~/lib/geometry';

/** Only projects with something to index; a one-room project is its own room page. */
export const getStaticPaths: GetStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    PROJECTS.filter((entry) => entry.rooms.length > 1).map((entry) => ({
      params: { locale, project: entry.project.id },
    })),
  );

const locale = Astro.params.locale as Locale;
const entry = projectById(Astro.params.project!)!;
const { project, rooms } = entry;

const cards = rooms.map((room) => {
  const design = preferredDesign(room);
  const findings = checkDesign(room, design);
  const area = roomArea(room);
  return {
    room,
    design,
    area,
    box: bbox(outlineOf(room)),
    findings,
    severity: worst(findings),
    covered: area > 0 ? Math.round((footprintArea(design) / area) * 100) : 0,
  };
});

const TONE = {
  error: { label: 'Conflict', chip: 'bg-flag-soft text-flag' },
  warning: { label: 'Tight', chip: 'bg-clay-soft text-clay' },
  note: { label: 'Noted', chip: 'bg-paper-deep text-ink-soft' },
} as const;
---

<BaseLayout
  locale={locale}
  title={`Rooms — ${project.name}`}
  description={`Every room in ${project.name}, each drawn to scale from its measured dimensions, with its furniture set out at real sizes.`}
>
  <section class="mx-auto max-w-6xl px-5 pt-10 pb-10 sm:px-8 sm:pt-14">
    <nav aria-label="Breadcrumb" class="text-2xs tracking-[0.14em] text-ink-faint uppercase">
      <a href={localeHref(locale, '/')} class="transition-colors hover:text-brand">Projects</a>
      <span class="mx-2">/</span>
      <a href={localeHref(locale, `/projects/${project.id}`)} class="transition-colors hover:text-brand">
        {project.name}
      </a>
      <span class="mx-2">/</span>
      <span class="text-ink-soft">Rooms</span>
    </nav>

    <h1 class="mt-5 font-serif text-3xl leading-tight font-bold text-ink sm:text-[2.4rem]">
      Room by room
    </h1>
    <p class="lede mt-5 max-w-2xl">
      The same plan as the project page, framed one room at a time. Each drawing keeps the walls, doors
      and windows around it, because a room's problems are usually on its boundary.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-4 sm:px-8">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        cards.map((card) => (
          <li class="card overflow-hidden">
            <a
              href={localeHref(locale, `/projects/${project.id}/rooms/${card.room.id}`)}
              class="group block"
            >
              <div class="border-b border-line bg-[#f7f4ee] p-2">
                <Plan
                  project={project}
                  rooms={rooms}
                  focus={card.room.id}
                  labels="none"
                  padding={700}
                  nominalWidth={520}
                  minWidth="min-w-0"
                  title={`Plan of the ${card.room.name.toLowerCase()}`}
                  desc={`${card.room.name}, ${card.box.width} by ${card.box.depth} millimetres, ${formatArea(card.area)}.`}
                />
              </div>
              <div class="p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-2xs tracking-[0.14em] text-ink-faint uppercase">
                    {KIND_LABELS[card.room.kind]}
                  </span>
                  {card.room.designs.length > 1 && (
                    <span class="rounded-full bg-brand-soft px-2 py-0.5 text-2xs font-bold text-brand-deep">
                      {card.room.designs.length} designs
                    </span>
                  )}
                  {card.severity && (
                    <span
                      class:list={[
                        'rounded-full px-2 py-0.5 text-2xs font-bold',
                        TONE[card.severity].chip,
                      ]}
                    >
                      {TONE[card.severity].label} · {card.findings.length}
                    </span>
                  )}
                </div>
                <h2 class="mt-2 font-serif text-xl font-bold text-ink transition-colors group-hover:text-brand">
                  {card.room.name}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{card.design.theme}</p>
                <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-line-soft pt-4">
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Floor</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">{formatArea(card.area)}</dd>
                  </div>
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Clear size</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">
                      {card.box.width} × {card.box.depth}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-2xs text-ink-faint uppercase">Covered</dt>
                    <dd class="mt-0.5 text-sm font-bold text-ink tabular">{card.covered}%</dd>
                  </div>
                </dl>
                <p class="mt-3 text-2xs tracking-[0.14em] text-ink-faint uppercase">
                  {STYLES[card.design.style].name}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
