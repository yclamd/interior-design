---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CATALOGUE_IDS, catalogueItem } from '~/data/catalogue';
import { KIND_LABELS } from '~/data/projects';
import { STYLES, STYLE_ORDER } from '~/data/styles';
import type { RoomKind, Side } from '~/data/types';
import { say, LOCALES, strings, type Locale } from '~/i18n';

export const getStaticPaths: GetStaticPaths = () =>
  LOCALES.map((locale) => ({ params: { locale } }));

const locale = Astro.params.locale as Locale;
const s = strings(locale);

/**
 * The planner: the site's own engine, running in the reader's browser.
 *
 * This is the one page that ships JavaScript, and it exists because the engine was
 * already the right shape for it. The module below imports the same pure functions the
 * build uses — fromCatalogue, checkDesign, the geometry, the plan colours — so a room
 * drawn here cannot disagree with a room drawn by the build, and a finding reported here
 * is the finding the audit page would report. No framework and no server: the markup is
 * the interface and the module drives it.
 *
 * Input is a shell and some objects. Output is three things — the drawing, the findings,
 * and the room as source in the format the rest of the dataset is written in, so the
 * answer to "what do I do with this" is "paste it in".
 */

/** Anything that stands on the floor. A wall-hung piece has no position to set here. */
const pickable = CATALOGUE_IDS.filter((id) => catalogueItem(id).mountedAt === undefined).map(
  (id) => {
    const item = catalogueItem(id);
    /** The catalogue's own names are not localised yet, so they are read straight. */
    return { id, label: `${item.name} — ${item.width}×${item.depth}` };
  },
);

const SIDES: Side[] = ['north', 'east', 'south', 'west'];

const SIDE_LABELS: Record<Side, Record<Locale, string>> = {
  north: { en: 'North', zh: '北' },
  east: { en: 'East', zh: '東' },
  south: { en: 'South', zh: '南' },
  west: { en: 'West', zh: '西' },
};

/** The kinds worth offering: what a person draws a single room for. */
const KINDS: RoomKind[] = ['living', 'dining', 'kitchen', 'bedroom', 'study', 'bathroom', 'utility'];

const TEXT = {
  shell: { en: 'The shell', zh: '外殼' },
  kind: { en: 'What the room is', zh: '房間類型' },
  style: { en: 'Palette', zh: '色調' },
  openings: { en: 'Doors and windows', zh: '門與窗' },
  openingsNote: {
    en: 'A room needs a way in, and a room to spend time in needs daylight. Both are checked.',
    zh: '房間需要進得去，久待的房間需要採光。兩者都會被檢查。',
  },
  addDoor: { en: '+ Door', zh: '＋ 門' },
  addWindow: { en: '+ Window', zh: '＋ 窗' },
  aDoor: { en: 'Door', zh: '門' },
  aWindow: { en: 'Window', zh: '窗' },
  side: { en: 'Side', zh: '方位' },
  openingWidth: { en: 'Width', zh: '寬' },
  along: { en: 'Along', zh: '位置' },
  remove: { en: 'Remove', zh: '移除' },
  noOpenings: {
    en: 'No doors or windows. This room has no way in.',
    zh: '沒有門也沒有窗，這個房間進不去。',
  },
  openSides: { en: 'Sides with no wall', zh: '沒有牆的邊' },
  openSidesNote: {
    en: 'An open-plan room is not walled on all four sides. Say which sides stand open and no wall is drawn there.',
    zh: '開放式空間不會四面都是牆。指定哪幾邊是開放的，那幾邊就不會畫牆。',
  },
  choose: { en: 'Choose an object…', zh: '選一個物件…' },
  pieces: { en: 'In the room', zh: '房間內的物件' },
  roomArea: { en: 'Clear floor', zh: '淨面積' },
  overall: { en: 'Outside face', zh: '外緣尺寸' },
  empty: { en: 'Nothing in the room yet.', zh: '房間裡還沒有東西。' },
  facing: {
    en: ['faces south', 'faces west', 'faces north', 'faces east'],
    zh: ['朝南', '朝西', '朝北', '朝東'],
  },
} as const;

const l = {
  shell: TEXT.shell[locale],
  kind: TEXT.kind[locale],
  style: TEXT.style[locale],
  openings: TEXT.openings[locale],
  openingsNote: TEXT.openingsNote[locale],
  addDoor: TEXT.addDoor[locale],
  addWindow: TEXT.addWindow[locale],
  openSides: TEXT.openSides[locale],
  openSidesNote: TEXT.openSidesNote[locale],
  choose: TEXT.choose[locale],
  pieces: TEXT.pieces[locale],
  roomArea: TEXT.roomArea[locale],
  overall: TEXT.overall[locale],
  empty: TEXT.empty[locale],
};

/** Handed to the module so it holds no dictionary and the page decides the language. */
const plannerText = {
  facing: [0, 90, 180, 270].map((value, i) => ({
    value,
    label: TEXT.facing[locale][i]!,
  })),
  remove: s.planner.remove,
  rotation: s.planner.rotation,
  clear: s.common.nothingFlagged,
};
---

<BaseLayout locale={locale} title={s.planner.title} description={s.planner.lede}>
  <section class="mx-auto max-w-6xl px-5 pt-12 pb-8 sm:px-8">
    <h1 class="font-serif text-3xl leading-tight font-bold text-ink sm:text-[2.4rem]">
      {s.planner.title}
    </h1>
    <p class="lede mt-4 max-w-2xl">{s.planner.lede}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[21rem_1fr] lg:items-start">
      <div class="space-y-5">
        <fieldset class="card space-y-4 p-5">
          <legend class="px-1 text-2xs font-bold tracking-[0.14em] text-ink-faint uppercase">
            {l.shell}
          </legend>
          <label class="block">
            <span class="text-xs font-medium text-ink-soft">{s.planner.width}</span>
            <input
              id="p-width"
              type="number"
              value="3400"
              min="800"
              max="12000"
              step="10"
              class="mt-1 w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink tabular"
            />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-ink-soft">{s.planner.depth}</span>
            <input
              id="p-depth"
              type="number"
              value="3050"
              min="800"
              max="12000"
              step="10"
              class="mt-1 w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink tabular"
            />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-ink-soft">{s.planner.wall}</span>
            <input
              id="p-wall"
              type="number"
              value="100"
              min="50"
              max="400"
              step="10"
              class="mt-1 w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink tabular"
            />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-ink-soft">{l.kind}</span>
            <select
              id="p-kind"
              class="mt-1 w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink"
            >
              {
                KINDS.map((kind) => (
                  <option value={kind} selected={kind === 'living'}>
                    {say(KIND_LABELS[kind], locale)}
                  </option>
                ))
              }
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-medium text-ink-soft">{l.style}</span>
            <select
              id="p-style"
              class="mt-1 w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink"
            >
              {
                STYLE_ORDER.map((key) => (
                  <option value={key} selected={key === 'warm-minimal'}>
                    {say(STYLES[key].name, locale)}
                  </option>
                ))
              }
            </select>
          </label>
        </fieldset>

        <fieldset class="card space-y-3 p-5">
          <legend class="px-1 text-2xs font-bold tracking-[0.14em] text-ink-faint uppercase">
            {l.openings}
          </legend>
          <p class="text-xs leading-relaxed text-ink-faint">{l.openingsNote}</p>
          <div class="flex flex-wrap gap-2">
            <button
              id="p-add-door"
              type="button"
              class="rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors hover:bg-paper-deep"
            >
              {l.addDoor}
            </button>
            <button
              id="p-add-window"
              type="button"
              class="rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors hover:bg-paper-deep"
            >
              {l.addWindow}
            </button>
          </div>
          <ul id="p-openings" class="space-y-2"></ul>

          {
            /**
             * Labels the script needs, passed as data rather than duplicated in it. The
             * translations stay where every other translation on the page lives, and the
             * client bundle carries no second copy of them.
             */
          }
          <script id="p-side-labels" type="application/json" is:inline set:html={JSON.stringify(
            Object.fromEntries(SIDES.map((side) => [side, SIDE_LABELS[side][locale]])),
          )} />
          <script id="p-opening-labels" type="application/json" is:inline set:html={JSON.stringify({
            door: TEXT.aDoor[locale],
            window: TEXT.aWindow[locale],
            side: TEXT.side[locale],
            width: TEXT.openingWidth[locale],
            along: TEXT.along[locale],
            remove: TEXT.remove[locale],
            none: TEXT.noOpenings[locale],
          })} />

          <div>
            <p class="text-xs font-medium text-ink-soft">{l.openSides}</p>
            <p class="mt-1 text-2xs leading-relaxed text-ink-faint">{l.openSidesNote}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {
                SIDES.map((side) => (
                  <label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs text-ink transition-colors hover:bg-paper-deep">
                    <input type="checkbox" data-open-side={side} class="accent-brand" />
                    {SIDE_LABELS[side][locale]}
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>

        <fieldset class="card space-y-3 p-5">
          <legend class="px-1 text-2xs font-bold tracking-[0.14em] text-ink-faint uppercase">
            {s.planner.addPiece}
          </legend>
          <select
            id="p-add"
            class="w-full rounded-lg border border-line bg-card px-3 py-2 text-sm text-ink"
          >
            <option value="">{l.choose}</option>
            {pickable.map((item) => <option value={item.id}>{item.label}</option>)}
          </select>
          <p class="text-2xs tracking-[0.12em] text-ink-faint uppercase">{l.pieces}</p>
          <ul id="p-list" class="space-y-2"></ul>
          <p id="p-empty" class="text-xs text-ink-faint">{l.empty}</p>
        </fieldset>
      </div>

      <div class="space-y-5">
        <div class="table-scroll rounded-xl border border-line bg-[#f7f4ee] p-2">
          <svg id="p-svg" class="h-auto w-full" role="img" aria-label={s.planner.title}></svg>
        </div>

        <dl class="grid grid-cols-3 gap-3">
          <div class="card p-4">
            <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{l.roomArea}</dt>
            <dd id="p-area" class="mt-1 font-serif text-xl font-bold text-ink tabular">—</dd>
          </div>
          <div class="card p-4">
            <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">
              {s.planner.coverage}
            </dt>
            <dd id="p-coverage" class="mt-1 font-serif text-xl font-bold text-ink tabular">—</dd>
          </div>
          <div class="card p-4">
            <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{l.overall}</dt>
            <dd id="p-outer" class="mt-1 font-serif text-base font-bold text-ink tabular">—</dd>
          </div>
        </dl>

        <div class="card p-5">
          <h2 class="text-2xs font-bold tracking-[0.14em] text-ink-faint uppercase">
            {s.common.findings}
          </h2>
          <ul id="p-findings" class="mt-2 space-y-2"></ul>
        </div>

        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-2xs font-bold tracking-[0.14em] text-ink-faint uppercase">
              {s.planner.exportTitle}
            </h2>
            <button
              id="p-copy"
              type="button"
              data-copy={s.planner.copy}
              data-copied={s.planner.copied}
              class="rounded-full bg-ink px-3 py-1 text-2xs font-bold text-paper transition-colors hover:bg-brand-deep"
            >
              {s.planner.copy}
            </button>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-ink-faint">{s.planner.exportNote}</p>
          <pre
            id="p-data"
            class="mt-3 overflow-x-auto rounded-lg bg-paper-deep/60 p-3 font-mono text-2xs leading-relaxed text-ink"></pre>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ plannerText }}>
  window.plannerText = plannerText;
</script>

<script>
  import { catalogueItem, fromCatalogue, type CatalogueId } from '~/data/catalogue';
  import { STYLES } from '~/data/styles';
  import type {
    Design,
    Furniture,
    Opening,
    Project,
    Room,
    RoomKind,
    Side,
    StyleKey,
  } from '~/data/types';
  import { checkDesign, checkRoom } from '~/lib/checks';
  import {
    bbox,
    formatArea,
    formatLength,
    grow,
    outlineInPlan,
    pathOf,
    roomArea,
  } from '~/lib/geometry';
  import {
    PLAN_COLOURS,
    floorRender,
    frameFor,
    furnitureRenders,
    isDoorway,
    openingRender,
    roomFill,
    roomPath,
    wallBandsPath,
  } from '~/lib/plan';
  import {
    floorPatternSvg,
    furnitureSvg,
    openingSvg,
    shadowFilterSvg,
    weavePatternSvg,
  } from '~/lib/draw';

  const text = (
    window as unknown as {
      plannerText: {
        facing: { value: number; label: string }[];
        remove: string;
        rotation: string;
        clear: string;
      };
    }
  ).plannerText;

  interface Placed {
    key: number;
    ref: CatalogueId;
    x: number;
    y: number;
    rotation: number;
  }

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const inputs = {
    width: el<HTMLInputElement>('p-width'),
    depth: el<HTMLInputElement>('p-depth'),
    wall: el<HTMLInputElement>('p-wall'),
    kind: el<HTMLSelectElement>('p-kind'),
    style: el<HTMLSelectElement>('p-style'),
    add: el<HTMLSelectElement>('p-add'),
  };
  const out = {
    svg: document.getElementById('p-svg') as unknown as SVGSVGElement,
    list: el<HTMLUListElement>('p-list'),
    empty: el<HTMLParagraphElement>('p-empty'),
    area: el('p-area'),
    coverage: el('p-coverage'),
    outer: el('p-outer'),
    findings: el<HTMLUListElement>('p-findings'),
    data: el<HTMLPreElement>('p-data'),
    copy: el<HTMLButtonElement>('p-copy'),
  };

  let pieces: Placed[] = [{ key: 1, ref: 'sofa-three-seat', x: 610, y: 2100, rotation: 180 }];
  let nextKey = 2;

  /**
   * A room starts with a door, because a room without one is not a room. The default is
   * a 900 door hard against the west end of the south wall, which is where a door usually
   * is and which nobody has to think about to get started.
   */
  let openings: Opening[] = [
    {
      id: 'door',
      kind: 'door-swing',
      side: 'south',
      offset: 200,
      width: 900,
      height: 2100,
      sill: 0,
      swing: 'left-in',
      to: 'outside',
    },
    /** And a window, because a living room without one fails its own daylight check. */
    {
      id: 'window',
      kind: 'window',
      side: 'east',
      offset: 700,
      width: 1600,
      height: 1400,
      sill: 900,
      to: 'outside',
    },
  ];
  let nextOpening = 1;
  let openSides: Side[] = [];

  const num = (input: HTMLInputElement) => {
    const value = Math.round(input.valueAsNumber);
    const min = Number(input.min);
    const max = Number(input.max);
    return Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : min;
  };

  /**
   * Rebuilt on every change and thrown away. A Room and a Design are plain data, so the
   * cheapest way to reuse the engine is to hand it the shapes the dataset holds rather
   * than to keep a second, lighter model of any of it in step with the first.
   */
  function build() {
    const width = num(inputs.width);
    const depth = num(inputs.depth);
    const wall = num(inputs.wall);
    const style = inputs.style.value as StyleKey;

    const furniture: Furniture[] = pieces.map((piece) =>
      fromCatalogue(piece.ref, piece.x, piece.y, {
        id: `piece-${piece.key}`,
        rotation: piece.rotation,
      }),
    );
    const design: Design = {
      id: 'draft',
      name: 'Draft',
      preferred: true,
      theme: '',
      summary: '',
      style,
      floor: { name: 'Boards', colour: STYLES[style].palette.floor },
      furniture,
    };
    const room: Room = {
      id: 'draft',
      name: 'Room',
      kind: inputs.kind.value as RoomKind,
      origin: { x: wall, y: wall },
      shape: { kind: 'rect', width, depth },
      ceiling: 2600,
      open: [...openSides],
      openings: openings.map((opening) => ({ ...opening })),
      designs: [design],
    };
    /**
     * A project, because the drawing needs wall thicknesses and an envelope. No envelope
     * is stated, so it is taken as the room grown by one exterior wall — which is exactly
     * right for a single room and means the poché comes out at the thickness set above.
     */
    const project: Project = {
      id: 'draft',
      name: 'Draft',
      location: '',
      scope: 'room',
      northOffset: 0,
      walls: { exterior: wall, interior: wall },
      ceiling: 2600,
      style,
      premise: '',
    };
    return { room, design, project, width, depth, wall, style };
  }

  const openingsOf = (room: Room): Opening[] => room.openings;

  /* ── Doors, windows and open sides ──────────────────────────────────────── */

  const SIDES: Side[] = ['north', 'east', 'south', 'west'];
  const SIDE_TEXT: Record<Side, string> = JSON.parse(
    document.getElementById('p-side-labels')?.textContent ?? '{}',
  );
  const OPENING_TEXT: Record<string, string> = JSON.parse(
    document.getElementById('p-opening-labels')?.textContent ?? '{}',
  );

  /** Where a new opening goes: the middle of the longest side that has no opening yet. */
  function freeSide(): Side {
    const taken = new Set(openings.map((opening) => opening.side));
    const free = SIDES.filter((side) => !taken.has(side));
    const order = (side: Side) =>
      side === 'north' || side === 'south' ? Number(inputs.width.value) : Number(inputs.depth.value);
    const pool = free.length > 0 ? free : SIDES;
    return [...pool].sort((a, b) => order(b) - order(a))[0]!;
  }

  const sideRun = (side: Side): number =>
    side === 'north' || side === 'south' ? Number(inputs.width.value) : Number(inputs.depth.value);

  function addOpening(kind: 'door-swing' | 'window') {
    const side = freeSide();
    const width = kind === 'window' ? 1500 : 900;
    /** Centred, because the middle of a wall is never a wrong first guess. */
    const offset = Math.max(0, Math.round((sideRun(side) - width) / 2));
    openings = [
      ...openings,
      kind === 'window'
        ? { id: `w${nextOpening}`, kind, side, offset, width, height: 1400, sill: 900, to: 'outside' }
        : {
            id: `d${nextOpening}`,
            kind,
            side,
            offset,
            width,
            height: 2100,
            sill: 0,
            swing: 'left-in',
            to: 'outside',
          },
    ];
    nextOpening += 1;
    /** A side cannot be both open and carry a door: the door would be in nothing. */
    openSides = openSides.filter((s) => s !== side);
    syncOpenSides();
    renderOpenings();
    draw();
  }

  /**
   * One row per opening: what it is, which side, how wide, how far along. Four controls,
   * which is as few as the thing can be described in and still be moved where it belongs.
   */
  function renderOpenings() {
    const list = document.getElementById('p-openings');
    if (!list) return;
    if (openings.length === 0) {
      list.innerHTML = `<li class="text-xs text-flag">${OPENING_TEXT.none}</li>`;
      return;
    }
    list.innerHTML = openings
      .map((opening, index) => {
        const run = sideRun(opening.side);
        const glazed = opening.kind.startsWith('window');
        return (
          `<li class="rounded-lg border border-line bg-paper-deep/40 p-2.5" data-opening="${index}">` +
          `<div class="flex items-center justify-between gap-2">` +
          `<span class="text-xs font-medium text-ink">${glazed ? OPENING_TEXT.window : OPENING_TEXT.door}</span>` +
          `<button type="button" data-drop-opening="${index}" class="text-2xs text-ink-faint hover:text-flag" aria-label="${OPENING_TEXT.remove}">${OPENING_TEXT.remove}</button>` +
          `</div>` +
          `<div class="mt-2 grid grid-cols-3 gap-2">` +
          `<label class="block"><span class="text-2xs text-ink-faint">${OPENING_TEXT.side}</span>` +
          `<select data-field="side" class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs text-ink">` +
          SIDES.map(
            (side) =>
              `<option value="${side}"${side === opening.side ? ' selected' : ''}>${SIDE_TEXT[side]}</option>`,
          ).join('') +
          `</select></label>` +
          `<label class="block"><span class="text-2xs text-ink-faint">${OPENING_TEXT.width}</span>` +
          `<input data-field="width" type="number" min="600" max="${run}" step="50" value="${opening.width}" class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs text-ink"/></label>` +
          `<label class="block"><span class="text-2xs text-ink-faint">${OPENING_TEXT.along}</span>` +
          `<input data-field="offset" type="number" min="0" max="${Math.max(0, run - opening.width)}" step="50" value="${opening.offset}" class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs text-ink"/></label>` +
          `</div></li>`
        );
      })
      .join('');
  }

  function syncOpenSides() {
    for (const box of document.querySelectorAll<HTMLInputElement>('[data-open-side]')) {
      const side = box.dataset.openSide as Side;
      box.checked = openSides.includes(side);
      /** A side carrying a door or window cannot also be open, so say so rather than allow it. */
      const used = openings.some((opening) => opening.side === side);
      box.disabled = used;
      box.parentElement?.classList.toggle('opacity-40', used);
    }
  }

  document.getElementById('p-add-door')?.addEventListener('click', () => addOpening('door-swing'));
  document.getElementById('p-add-window')?.addEventListener('click', () => addOpening('window'));

  document.getElementById('p-openings')?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-drop-opening]');
    if (!button) return;
    openings = openings.filter((_, i) => i !== Number(button.dataset.dropOpening));
    syncOpenSides();
    renderOpenings();
    draw();
  });

  document.getElementById('p-openings')?.addEventListener('change', (event) => {
    const field = (event.target as HTMLElement).closest<HTMLElement>('[data-field]');
    const row = (event.target as HTMLElement).closest<HTMLElement>('[data-opening]');
    if (!field || !row) return;
    const index = Number(row.dataset.opening);
    const opening = openings[index];
    if (!opening) return;
    const value = (field as HTMLInputElement | HTMLSelectElement).value;

    if (field.dataset.field === 'side') {
      opening.side = value as Side;
      openSides = openSides.filter((s) => s !== opening.side);
    } else if (field.dataset.field === 'width') {
      opening.width = Number(value);
    } else {
      opening.offset = Number(value);
    }

    /** Kept inside its wall, so an opening can never run off the end of the side it is on. */
    const run = sideRun(opening.side);
    opening.width = Math.min(Math.max(600, opening.width), run);
    opening.offset = Math.min(Math.max(0, opening.offset), run - opening.width);

    syncOpenSides();
    renderOpenings();
    draw();
  });

  for (const box of document.querySelectorAll<HTMLInputElement>('[data-open-side]')) {
    box.addEventListener('change', () => {
      const side = box.dataset.openSide as Side;
      openSides = box.checked ? [...openSides, side] : openSides.filter((s) => s !== side);
      draw();
    });
  }

  /**
   * The drawing, through the same functions the published plans go through.
   *
   * Nothing here decides what a sofa looks like. It composes: the frame, the poché, the
   * floor pattern, then each piece through furnitureSvg. That is the whole point of the
   * exercise — a room arranged here comes out drawn to the standard of the rooms on the
   * rest of the site, because it is not a second renderer that happens to look similar.
   */
  function draw() {
    const { room, design, project, width, depth, wall } = build();

    const outer = grow(bbox(outlineInPlan(room)), wall);
    const frame = frameFor(outer, Math.max(240, Math.round(Math.max(width, depth) * 0.08)), 900);
    const px = frame.px;
    out.svg.setAttribute('viewBox', frame.viewBox);

    const floor = floorRender(design);
    const ids = { floor: 'pl-floor', cast: 'pl-cast', weave: 'pl-weave' };

    const defs =
      floorPatternSvg(ids.floor, floor, px) +
      weavePatternSvg(ids.weave, px) +
      shadowFilterSvg(ids.cast, px);

    const pieces = furnitureRenders(room, design)
      .map((piece) => furnitureSvg(piece, px, { detail: true, cast: ids.cast, weave: ids.weave }))
      .join('');

    const openings = openingsOf(room)
      .map((opening) =>
        openingSvg(openingRender(project, new Set([room.id]), room, opening), px, {
          fill: isDoorway(opening.kind) ? roomFill(design) : PLAN_COLOURS.sheet,
          swept: true,
        }),
      )
      .join('');

    out.svg.innerHTML =
      `<defs>${defs}</defs>` +
      `<rect x="${frame.box.x}" y="${frame.box.y}" width="${frame.box.width}" height="${frame.box.depth}" fill="${PLAN_COLOURS.sheet}"/>` +
      `<path d="${wallBandsPath(room, wall)}" fill="${PLAN_COLOURS.structure}" stroke="${PLAN_COLOURS.structureEdge}" stroke-width="${px(1.4)}"/>` +
      /**
       * The floor, with no outline on it. An open side has no wall, and a line along it
       * says there is one; the poché is what draws an edge, so where there is no poché
       * there should be nothing at all.
       */
      `<path d="${roomPath(room)}" fill="${floor.pattern === 'none' ? roomFill(design) : `url(#${ids.floor})`}"/>` +
      openings +
      pieces;

    const area = roomArea(room);
    const covered = design.furniture
      .filter((item) => item.kind !== 'rug' && item.mountedAt === undefined)
      .reduce((sum, item) => sum + item.width * item.depth, 0);

    out.area.textContent = formatArea(area);
    out.coverage.textContent = area > 0 ? `${Math.round((covered / area) * 100)}%` : '—';
    out.outer.textContent = `${formatLength(outer.width)} × ${formatLength(outer.depth)}`;

    /**
     * The shell first, then the furniture. Whether a room has a door outranks whether a
     * coffee table is too close to a sofa, and the sort in the display puts errors above
     * warnings anyway, so a sealed box says so at the top of the list.
     */
    const findings = [...checkRoom(room), ...checkDesign(room, design)];
    out.findings.innerHTML =
      findings.length === 0
        ? `<li class="text-sm text-ink-soft">${text.clear}</li>`
        : findings
            .map(
              (finding) =>
                `<li class="flex gap-2 text-sm leading-relaxed"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full ${
                  finding.severity === 'error' ? 'bg-flag' : 'bg-clay'
                }" aria-hidden="true"></span><span class="text-ink-soft">${
                  finding.message
                }</span></li>`,
            )
            .join('');

    out.data.textContent = asSource(width, depth, wall, inputs.style.value);
  }

  /** The format the rest of the dataset is written in, ready to paste into a room file. */
  function asSource(width: number, depth: number, wall: number, style: string) {
    const placed = pieces
      .map((piece) => {
        const turn = piece.rotation === 0 ? '' : `, { rotation: ${piece.rotation} }`;
        return `      fromCatalogue('${piece.ref}', ${piece.x}, ${piece.y}${turn}),`;
      })
      .join('\n');
    return [
      'export const ROOM: Room = {',
      "  id: 'new-room',",
      "  name: 'New room',",
      "  kind: 'living',",
      `  origin: { x: ${wall}, y: ${wall} },`,
      `  shape: { kind: 'rect', width: ${width}, depth: ${depth} },`,
      '  ceiling: 2600,',
      '  openings: [],',
      '  designs: single({',
      "    theme: 'Drafted in the planner',",
      `    style: '${style}',`,
      "    floor: { name: 'Boards', pattern: 'plank', grain: 'ew', module: 190 },",
      "    summary: '',",
      '    furniture: [',
      placed,
      '    ],',
      '  }),',
      '};',
    ].join('\n');
  }

  function renderList() {
    out.empty.hidden = pieces.length > 0;
    out.list.innerHTML = pieces
      .map((piece) => {
        const item = catalogueItem(piece.ref);
        const options = text.facing
          .map(
            (face) =>
              `<option value="${face.value}"${
                face.value === piece.rotation ? ' selected' : ''
              }>${face.label}</option>`,
          )
          .join('');
        return `<li class="rounded-lg border border-line-soft bg-paper-deep/40 p-3" data-key="${piece.key}">
          <div class="flex items-baseline justify-between gap-2">
            <span class="text-xs font-medium text-ink">${item.name}</span>
            <button type="button" data-remove class="text-2xs text-flag hover:underline">${text.remove}</button>
          </div>
          <div class="mt-2 grid grid-cols-3 gap-2">
            <label class="block"><span class="text-2xs text-ink-faint">x</span>
              <input data-x type="number" value="${piece.x}" step="10" class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs tabular"/></label>
            <label class="block"><span class="text-2xs text-ink-faint">y</span>
              <input data-y type="number" value="${piece.y}" step="10" class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs tabular"/></label>
            <label class="block"><span class="text-2xs text-ink-faint">${text.rotation}</span>
              <select data-rot class="mt-0.5 w-full rounded border border-line bg-card px-1.5 py-1 text-xs">${options}</select></label>
          </div>
        </li>`;
      })
      .join('');
  }

  out.list.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement | HTMLSelectElement;
    const holder = (target.closest('[data-key]') as HTMLElement | null)?.dataset.key;
    const piece = pieces.find((p) => p.key === Number(holder));
    if (!piece) return;
    if (target.hasAttribute('data-x')) piece.x = Math.round(Number(target.value));
    if (target.hasAttribute('data-y')) piece.y = Math.round(Number(target.value));
    if (target.hasAttribute('data-rot')) piece.rotation = Number(target.value);
    draw();
  });

  out.list.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-remove]');
    if (!button) return;
    const key = Number((button.closest('[data-key]') as HTMLElement).dataset.key);
    pieces = pieces.filter((piece) => piece.key !== key);
    renderList();
    draw();
  });

  inputs.add.addEventListener('change', () => {
    const ref = inputs.add.value as CatalogueId;
    if (!ref) return;
    const item = catalogueItem(ref);
    pieces.push({
      key: nextKey++,
      ref,
      /** Dropped just inside the north-west corner, where it is always in view. */
      x: Math.max(0, Math.min(200, num(inputs.width) - item.width)),
      y: Math.max(0, Math.min(200, num(inputs.depth) - item.depth)),
      rotation: 0,
    });
    inputs.add.value = '';
    renderList();
    draw();
  });

  for (const input of [inputs.width, inputs.depth, inputs.wall, inputs.style, inputs.kind]) {
    input.addEventListener('input', () => {
      /**
       * Shrinking a room can leave an opening hanging off the end of its wall, so every
       * opening is pulled back inside before anything is drawn. The alternative is a
       * window drawn in mid-air, which the geometry would accept.
       */
      for (const opening of openings) {
        const run = sideRun(opening.side);
        opening.width = Math.min(opening.width, run);
        opening.offset = Math.min(opening.offset, Math.max(0, run - opening.width));
      }
      renderOpenings();
      draw();
    });
  }

  out.copy.addEventListener('click', async () => {
    await navigator.clipboard.writeText(out.data.textContent ?? '');
    out.copy.textContent = out.copy.dataset.copied ?? 'Copied';
    window.setTimeout(() => {
      out.copy.textContent = out.copy.dataset.copy ?? 'Copy';
    }, 1600);
  });

  renderOpenings();
  syncOpenSides();
  renderList();
  draw();
</script>
