---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/consts';
import { PROJECTS } from '~/data/projects';

const rooms = PROJECTS.reduce((sum, entry) => sum + entry.rooms.length, 0);
---

<BaseLayout title="Not a room on this site" description="That page does not exist here.">
  <section class="mx-auto max-w-2xl px-5 py-24 text-center sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-serif text-3xl font-bold text-ink">Not a room on this site</h1>
    <p class="lede mt-4">
      Nothing is at that address. There are {PROJECTS.length} projects here and {rooms} rooms between
      them, and every one of them is on a plan.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={withBase('/')}
        class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
      >
        All projects
      </a>
      <a
        href={withBase('/audit')}
        class="rounded-full border border-line bg-card px-5 py-2.5 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-deep"
      >
        The audit
      </a>
    </div>
  </section>
</BaseLayout>
